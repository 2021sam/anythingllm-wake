<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.2021sam.jarvis-api</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/server/apps/anythingllm-wake/.venv/bin/python</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>jarvis_api:app</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8001</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/server/apps/anythingllm-wake</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/server/Library/Logs/jarvis-api.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/server/Library/Logs/jarvis-api-error.log</string>
</dict>
</plist>
